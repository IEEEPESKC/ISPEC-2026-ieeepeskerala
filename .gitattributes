# Auto-detect text files and normalize line endings
* text=auto

# Text files with CRLF on Windows checkout
*.js text eol=crlf
*.jsx text eol=crlf
*.css text eol=crlf
*.html text eol=crlf
*.json text eol=crlf
*.md text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.docx binary
